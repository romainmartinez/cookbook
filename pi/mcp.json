{
  "mcpServers": {
    "agent-browser": {
      "command": "agent-browser",
      "args": [
        "mcp"
      ],
      "description": "Browser automation: open pages, read accessibility snapshots, click and fill elements"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--channel=beta"
      ],
      "enabled": false
    },
    "atlassian": {
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": false
    },
    "intervals-icu": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "intervals-icu-mcp"
      ],
      "env": {
        "INTERVALS_ICU_API_KEY": "${INTERVALS_ICU_API_KEY}",
        "INTERVALS_ICU_ATHLETE_ID": "${INTERVALS_ICU_ATHLETE_ID}",
        "INTERVALS_ICU_DELETE_MODE": "safe"
      },
      "enabled": false
    },
    "figma": {
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": false
    },
    "liftosaur": {
      "url": "https://www.liftosaur.com/mcp",
      "headers": {
        "Authorization": "Bearer ${LIFTOSAUR_API_KEY}"
      },
      "enabled": false
    }
  }
}

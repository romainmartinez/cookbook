#!/bin/sh

[ "$1" = get ] || exit 0

while IFS='=' read -r key value; do
    case "$key" in
        host) host=$value ;;
        username) username=$value ;;
    esac
done

[ "$host" = github.com ] || exit 0

if [ -n "$username" ]; then
    token=$(gh auth token --hostname "$host" --user "$username") || exit 1
else
    token=$(gh auth token --hostname "$host") || exit 1
fi

printf 'username=x-access-token\npassword=%s\n\n' "$token"
